# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est jamais commité (voir .gitignore).

NODE_ENV=development

# Supabase — projet partagé avec totem_backend (voir totem_backend/.env.example
# pour l'URL déjà en usage). Clés à récupérer dans Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://oeydpyuhycbpvcyjpmln.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL du backend NestJS (totem_backend). En local, l'API tourne par défaut sur
# le port défini par PORT dans totem_backend/.env (souvent 3001 puisque ce
# frontend occupe déjà le 3000).
TOTEM_BACKEND_URL=http://localhost:3001

# URL publique de ce site (sert à construire les success/cancel URL Stripe).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mode maintenance (voir proxy.ts) : bloque tout le site (pages + API) en 503
# quand MAINTENANCE_MODE=true. Contournement équipe :
# Ouvrir /api/bypass-maintenance et saisir la clé dans le formulaire POST.
# Cookie signé valable 8 heures ; changer la clé invalide les accès existants.
MAINTENANCE_MODE=false
## Optional estimated end: ISO date with explicit time zone; does not reopen the site.
MAINTENANCE_END_AT=
MAINTENANCE_BYPASS_SECRET=

# Compteurs partagés obligatoires en production (Upstash REST, serveur uniquement).
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# Hors Vercel : nom d'un en-tête IP écrasé par le reverse proxy de confiance.
# Sans cet en-tête, les visiteurs partagent un même compteur par action.
RATE_LIMIT_IP_HEADER=

# Formulaire de contact (voir totem_backend/.env pour la même clé Resend déjà
# utilisée là-bas — l'adresse expéditrice doit correspondre à un domaine
# vérifié dans Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Totem Ancestral
CONTACT_EMAIL=
