# ============ SUPABASE ============
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_KEY=<service-role-key>
# Alias accepte si votre plateforme l'utilise deja.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ============ BACKEND (pipeline NestJS) ============
# Requis en production : le pipeline de generation (texte/image/audio/PDF) est
# entierement delegue au backend NestJS. Doit pointer vers le backend deploye.
TOTEM_BACKEND_URL=https://<votre-backend>.onrender.com

# ============ STRIPE ============
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ORIGINE=price_...
STRIPE_PRICE_ANCESTRAL=price_...
STRIPE_PRICE_FAMILLE=price_...
STRIPE_PRICE_JUNIOR=price_...

# ============ RESEND (formulaire de contact) ============
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=livraison@totem-ancestral.com
RESEND_FROM_NAME=Totem Ancestral

# ============ ANTHROPIC / CLAUDE (flux Junior, optionnel) ============
# Utilise directement par le flux Junior. Sans cle, fallback deterministe local.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_JUNIOR=claude-sonnet-4-6

# ============ ADMIN ============
ADMIN_EMAIL=contact@totem-ancestral.com

# ============ SITE ============
NEXT_PUBLIC_SITE_URL=https://totem-ancestral.com
SITE_URL=https://totem-ancestral.com
