# ============ SUPABASE ============
NEXT_PUBLIC_SUPABASE_URL=https://oeydpyuhycbpvcyjpmln.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_KEY=<service-role-key>
# Alias accepte si votre plateforme l'utilise deja.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ============ BACKEND (pipeline NestJS) ============
# Requis en production : le pipeline de generation (texte/image/audio/PDF) est
# entierement delegue au backend NestJS. Doit pointer vers le backend deploye.
TOTEM_BACKEND_URL=https://totem-backend-o3v4.onrender.com

# Rate-limit BFF partagé (optionnel). Sans ces clés, repli in-memory par isolate Vercel.
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# ============ STRIPE ============
# Les prix sont crees a la volee via `price_data` (montant + libelle d'offre).
# Aucun produit / price_id a creer dans Stripe.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============ RESEND (formulaire de contact) ============
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=livraison@totem-ancestral.com
RESEND_FROM_NAME=Totem Ancestral

# ============ ADMIN ============
ADMIN_EMAIL=contact@totem-ancestral.com

# ============ SITE ============
NEXT_PUBLIC_SITE_URL=https://totem-ancestral.com
SITE_URL=https://totem-ancestral.com
