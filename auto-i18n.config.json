{
  "$schema": "./node_modules/next-auto-i18n/schema/auto-i18n.config.schema.json",
  "sourceLocale": "fr",
  "targetLocales": ["en"],
  "provider": "deepl",
  "apiKeyEnv": "AUTO_I18N_DEEPL_KEY",
  "messagesDir": "./messages",
  "ignore": [
    "node_modules",
    ".next",
    ".vercel",
    "dist",
    "build",
    "out",
    "public",
    "coverage",
    "src/app/api/**",
    "src/app/[locale]/**",
    "src/app/fgh55_fh/**",
    "src/app/layout.tsx",
    "src/app/page.tsx",
    "src/components/account/**",
    "src/components/AmbientAudio.tsx",
    "src/components/CookieConsent.tsx",
    "src/components/ExperienceConsignes.tsx",
    "src/components/Footer.tsx",
    "src/components/GoldParticles.tsx",
    "src/components/Header.tsx",
    "src/components/home/**",
    "src/components/IntroExperience.tsx",
    "src/components/MaskLogo.tsx",
    "src/components/PageHero.tsx",
    "src/components/pages/**",
    "src/components/Reveal.tsx",
    "src/components/sections.tsx",
    "src/components/SiteTourModal.tsx",
    "src/components/questionnaire/ParcoursPage.tsx",
    "src/components/questionnaire/JuniorParcoursPage.tsx",
    "src/components/ui/**",
    "src/hooks/**",
    "src/integrations/**",
    "src/lib/**",
    "src/routes/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
